{
    "default": [
        {
            "type": "insecureAcceptAnything"
        }
    ],
    "transports": {
        "docker": {
            "ghcr.io/zirconium-dev": [
                {
                    "type": "sigstoreSigned",
                    "keyPaths": [
                        "/usr/share/pki/containers/zirconium.pub",
                        "/usr/share/pki/containers/jackrabbit.pub",
                        "/usr/share/pki/containers/hawaii.pub"
                    ],
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ],
            "": [{"type":"insecureAcceptAnything"}]
        },
        "docker-daemon": {
            "": [{"type":"insecureAcceptAnything"}]
        }
    }
}
