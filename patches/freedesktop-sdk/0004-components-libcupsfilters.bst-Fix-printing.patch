From f98634d8c2c0ef98c06fcf52c072d8f097fea2b7 Mon Sep 17 00:00:00 2001
From: Valentin David <me@valentindavid.com>
Date: Sun, 18 Oct 2026 10:37:32 +0200
Subject: [PATCH 4/5] components/libcupsfilters.bst: Fix printing

Printing is broken with 2.2.1. Until a new releases fixes the issue
we need to backport upstream fixes:
* https://github.com/OpenPrinting/libcupsfilters/pull/167
* https://github.com/OpenPrinting/libcupsfilters/pull/249
---
 elements/components/libcupsfilters.bst        |  4 +++
 .../libcupsfilters/close-output-stream.patch  | 26 +++++++++++++++++++
 .../libcupsfilters/missing-root-object.patch  | 22 ++++++++++++++++
 3 files changed, 52 insertions(+)
 create mode 100644 patches/libcupsfilters/close-output-stream.patch
 create mode 100644 patches/libcupsfilters/missing-root-object.patch

diff --git a/elements/components/libcupsfilters.bst b/elements/components/libcupsfilters.bst
index 26b6ef538..38226dd8e 100644
--- a/elements/components/libcupsfilters.bst
+++ b/elements/components/libcupsfilters.bst
@@ -34,3 +34,7 @@ sources:
   exclude:
   - '*rc*'
   ref: 2.2.1-0-g2a00cf6aa4234e2e0ac91b9844ab8990d04c7089
+- kind: patch
+  path: patches/libcupsfilters/missing-root-object.patch
+- kind: patch
+  path: patches/libcupsfilters/close-output-stream.patch
diff --git a/patches/libcupsfilters/close-output-stream.patch b/patches/libcupsfilters/close-output-stream.patch
new file mode 100644
index 000000000..acd4d0ea4
--- /dev/null
+++ b/patches/libcupsfilters/close-output-stream.patch
@@ -0,0 +1,26 @@
+commit 1e66af63a81a188b9d4bce688d75f3a9df681165
+Author: Marshall Taplits <mtaplits@mailforce.net>
+Date:   Mon Sep 14 16:58:40 2026 -0400
+
+    bannertopdf: Close output stream so the generated PDF is not truncated (#249)
+
+diff --git a/cupsfilters/bannertopdf.c b/cupsfilters/bannertopdf.c
+index 60769e7b..9b2ce9aa 100644
+--- a/cupsfilters/bannertopdf.c
++++ b/cupsfilters/bannertopdf.c
+@@ -1021,6 +1021,14 @@ cfFilterBannerToPDF(int inputfd,         // I - File descriptor input stream
+   unlink(tempfile);
+   if (inputfp)
+     fclose(inputfp);
+-  
++  // The output stream has to be flushed and closed here. When this filter
++  // function is called from cfFilterChain() (as the "universal" filter does),
++  // the parent closes the raw output file descriptor and exits right after
++  // this function returns, so a still buffered tail of the generated PDF
++  // (cross-reference table and "%%EOF") would be lost and the following
++  // filter in the chain would fail to parse the file.
++  if (outputfp)
++    fclose(outputfp);
++
+   return (ret);
+ }
diff --git a/patches/libcupsfilters/missing-root-object.patch b/patches/libcupsfilters/missing-root-object.patch
new file mode 100644
index 000000000..0a1d513e4
--- /dev/null
+++ b/patches/libcupsfilters/missing-root-object.patch
@@ -0,0 +1,22 @@
+commit e14bad406189a66bdeb40131112944bfb58ee0cc
+Author: szlt5 <117269245+szlt5@users.noreply.github.com>
+Date:   Tue Aug 18 16:04:19 2026 +0800
+
+    Fix printing error:  pdfio output "Missing Root object." (#167)
+
+diff --git a/cupsfilters/pdf.c b/cupsfilters/pdf.c
+index 1f714b20..3e438609 100644
+--- a/cupsfilters/pdf.c
++++ b/cupsfilters/pdf.c
+@@ -165,6 +165,11 @@ cfPDFPagesFP(FILE *file) 	// I - File pointer of PDF
+     fwrite(buffer, 1, bytes_read, temp_fp);
+   }
+ 
++  // call fflush(temp_fp) to flush the stdio buffer; 
++  // otherwise pdfioFileOpen() may not see the complete contents of temp_filename because 
++  // some data may still be buffered and not yet written to the file.
++  fflush(temp_fp);  
++
+   // Open the temp file with pdfio
+   pdfio_file_t *pdf = pdfioFileOpen(temp_filename, NULL, NULL, NULL, NULL);
+ 
-- 
2.56.0

