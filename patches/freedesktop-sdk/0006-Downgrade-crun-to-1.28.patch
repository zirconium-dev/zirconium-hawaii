From 13241875db4f95331a5f8bf6881ff07d8e759175 Mon Sep 17 00:00:00 2001
From: Hec <hec@heccraft.com>
Date: Wed, 19 Aug 2026 11:59:02 -0400
Subject: [PATCH] Downgrade crun to 1.28

crun 1.29 breaks rootful distroboxes really hard.

Signed-off-by: Hec <hec@heccraft.com>
---
 elements/components/crun.bst                  |  7 ++++--
 .../0001-build-export-json_gen_-symbols.patch | 25 +++++++++++++++++++
 2 files changed, 30 insertions(+), 2 deletions(-)
 create mode 100644 patches/crun/0001-build-export-json_gen_-symbols.patch

diff --git a/elements/components/crun.bst b/elements/components/crun.bst
index 9f309f09b..08bb51970 100644
--- a/elements/components/crun.bst
+++ b/elements/components/crun.bst
@@ -26,11 +26,11 @@ sources:
 - kind: git_repo
   url: github:containers/crun.git
   track: '*.*'
-  ref: 1.29.1-0-gf0d911de5587342cfeb16473bf32ecdfeaf25957
+  ref: 1.28-0-g54f16ffbefcd022bf032af768b5c5ce075c18bfc
 - kind: git_module
   path: libocispec
   url: github:containers/libocispec.git
-  ref: 872b8b0b7ccb1a121601ede0dcac8c6b8a1008a6
+  ref: 8034d0ecd27f646ba3ffae5ff24db234ce062825
 - kind: git_module
   path: runtime-spec
   url: github:opencontainers/runtime-spec.git
@@ -41,3 +41,6 @@ sources:
   url: github:opencontainers/image-spec.git
   directory: libocispec
   ref: 26647a49f642c7d22a1cd3aa0a48e4650a542269
+# backport of https://github.com/containers/crun/pull/2102
+- kind: patch
+  path: patches/crun/0001-build-export-json_gen_-symbols.patch
diff --git a/patches/crun/0001-build-export-json_gen_-symbols.patch b/patches/crun/0001-build-export-json_gen_-symbols.patch
new file mode 100644
index 000000000..fe4a8ad52
--- /dev/null
+++ b/patches/crun/0001-build-export-json_gen_-symbols.patch
@@ -0,0 +1,25 @@
+From 88b80eb41715840476fc247407ace243b9059207 Mon Sep 17 00:00:00 2001
+From: Giuseppe Scrivano <gscrivan@redhat.com>
+Date: Thu, 28 May 2026 08:52:48 +0000
+Subject: [PATCH] build: export json_gen_* symbols
+
+Closes: https://github.com/containers/crun/issues/2101
+Signed-off-by: Giuseppe Scrivano <gscrivan@redhat.com>
+---
+ libcrun.lds | 1 +
+ 1 file changed, 1 insertion(+)
+
+diff --git a/libcrun.lds b/libcrun.lds
+index cafa585..8e14172 100644
+--- a/libcrun.lds
++++ b/libcrun.lds
+@@ -6,5 +6,6 @@
+         runtime_spec_*;
+         free_runtime_spec_*;
+         make_runtime_spec_*;
++        json_gen_*;
+   local: *;
+ };
+-- 
+2.54.0
