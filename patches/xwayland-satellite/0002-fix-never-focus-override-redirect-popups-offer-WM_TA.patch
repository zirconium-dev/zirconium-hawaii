+fn popup_override_redirect_never_focused_nor_offered() {
+    for accepts_input in [true, false] {
+        for take_focus in [false, true] {
+            let (mut f, comp) = TestFixture::new_with_compositor();
+
+            let (win_toplevel, _) =
