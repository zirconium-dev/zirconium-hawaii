#!/bin/bash

set -xeuo pipefail

for f in /etc/initial_scripts/*; do
  $f /
done

# FIXME: use CONFEXT_LEVEL in the future
mkdir -p /usr/lib/confexts/factory
cp --archive --no-target-directory --update=none "/etc" "/usr/lib/confexts/factory/etc"
mkdir -p /usr/lib/confexts/factory/etc/extension-release.d
printf 'ID=_any' > /usr/lib/confexts/factory/etc/extension-release.d/extension-release.factory
