build-depends:
- freedesktop-sdk.bst:public-stacks/buildsystem-rust.bst
- freedesktop-sdk.bst:components/bpf-maybe.bst
- freedesktop-sdk.bst:components/pkg-config.bst
- freedesktop-sdk.bst:components/rust-src.bst

depends:
- freedesktop-sdk.bst:components/dbus.bst
- freedesktop-sdk.bst:components/hwdata.bst
- freedesktop-sdk.bst:components/libdrm.bst
- freedesktop-sdk.bst:components/sqlite.bst
- freedesktop-sdk.bst:components/systemd.bst
- freedesktop-sdk.bst:components/xorg-lib-xcb.bst
- gnome-build-meta.bst:core-deps/upower.bst

environment-nocache:
- MAXJOBS

config:
  configure-commands:
  - |
    mkdir -p .cargo
    # else it'll try to use clang to build bpf code, which doesn't work at all
    cat >> .cargo/config.toml <<EOF
    [target.bpfel-unknown-none]
    linker = "bpf-linker"
    EOF
  - |
    # we need crates from rust-src, but the .cargo/config.toml from the cargo2 source plugin excludes it. so...
    # explicitly using /usr/lib here instead of %{indep-libdir} since there are some cases where the prefix could be
    # /app, so %{indep-libdir} would be /app/lib :p
    ln -s /usr/lib/rustlib/src/rust/vendor/* .vendored-crates/ || :
  build-commands:
  - |
    cargo build --release --frozen --jobs "${MAXJOBS}"
  install-commands:
  - |
    install -Dm755 target/release/cardwire "%{install-root}%{bindir}/cardwire"
    install -Dm755 target/release/cardwired "%{install-root}%{bindir}/cardwired"
    install -Dm755 target/release/cardwire-gui "%{install-root}%{bindir}/cardwire-gui"
    install -Dm644 assets/cardwired.service "%{install-root}%{indep-libdir}/systemd/system/cardwired.service"
    install -Dm644 assets/org.opengamingcollective.cardwire.conf "%{install-root}%{datadir}/dbus-1/system.d/org.opengamingcollective.cardwire.conf"
    install -Dm644 assets/cardwire-gui.desktop "%{install-root}%{datadir}/applications/cardwire-gui.desktop"
    install -Dm644 assets/org.opengamingcollective.cardwire.metainfo.xml "%{install-root}%{datadir}/metainfo/org.opengamingcollective.cardwire.metainfo.xml"
    for icon in assets/icons/*.svg; do
      install -Dm644 "$icon" "%{install-root}%{datadir}/icons/hicolor/scalable/apps/$(basename "$icon")"
    done
  - |
    %{install-extra}
