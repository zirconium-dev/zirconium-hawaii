kind: manual

environment:
  PATH: "%{build-root}/bpf-linker-bin:/usr/bin"
  LIBSQLITE3_SYS_USE_PKG_CONFIG: 1
  RUSTC_BOOTSTRAP: 1 # needs nightly features
  CARGO_TARGET_DIR: target
  RUST_TOOLCHAIN: stable
  MAXJOBS: '%{max-jobs}'

sources:
- kind: git_repo
  url: github:OpenGamingCollective/cardwire.git
  track: "*"
  ref: v0.12.3-0-g92c3e96cddf9a062aba36d316aab73eefbf871e2
  exclude:
  - "*-rc*"
  - "*-alpha*"
  - "*-beta*"
# cardwire needs a bpf-linker binary that is linked to llvm 23. FDSDK uses llvm 22 right now, so download a statically
# linked binary that is linked with llvm 23. when fdsdk uses llvm 23, make bpf-linker into a separate built element
- kind: anitya
  project-id: 391850
  directory: bpf-linker-bin
  url: github_files:aya-rs/bpf-linker/releases/download/v{version}/bpf-linker-%{arch}-unknown-linux-musl.tar.zst
  (?):
  - arch == "x86_64":
      ref:
        version: 0.13.0
        sha256sum: 0e9b2b30f68898177f1cb6f0ecbfa909a82479473a49a0ef66529fd088e3e410
  - arch == "aarch64":
      ref:
        version: 0.13.0
        sha256sum: 248e25f5c6a7242b054bd8f705470abb7a5a79b2b7c07df347c5d7049b783452
